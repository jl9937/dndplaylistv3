// Cloudflare Workers static assets (D7). No Worker script: Cloudflare serves dist/ directly,
// applying dist/_headers (CSP and security headers, copied from public/).
{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "dndplaylistv3",
  "compatibility_date": "2026-10-01",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "single-page-application"
  },
  "workers_dev": true
}
